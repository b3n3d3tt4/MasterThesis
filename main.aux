\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Illustration of the workflow of the data processing for two types of waveforms taken from run \textit  {r000} of period \textit  {p03}: the orange one is a typical \ac {MSE} waveform with a non-trivial structure while the blue one is a ordinary \ac {SSE} waveform. Raw waveforms depicted in Fig.\ref {fig:a-raw-wf} follows this procedure: the baseline, computed as the average value of the first 200 points (200 ns) is subtracted from the whole signal (\ref {fig:b-baseline}); then waveforms are then normalised to their maximum in order to have their amplitude between 0 and 1 (\ref {fig:c-normalised}); after that, they are aligned in time with the 50\% of the maximum as reference point to be aligned (\ref {fig:d-aligned}) and then trimmed in a 200 ns window around the center of the waveform, i.e. the alignement point \ref {fig:e-trimmed}. Finally the time derivative is computed in order to get the current waveforms exhibit in \ref {fig:f-current} where the two usual patterns of current in \ac {MSE} and \ac {SSE} are evident.}}{29}{figure.caption.28}\protected@file@percent }
\newlabel{fig:data-cleaning}{{4.1}{29}{Illustration of the workflow of the data processing for two types of waveforms taken from run \textit {r000} of period \textit {p03}: the orange one is a typical \ac {MSE} waveform with a non-trivial structure while the blue one is a ordinary \ac {SSE} waveform. Raw waveforms depicted in Fig.\ref {fig:a-raw-wf} follows this procedure: the baseline, computed as the average value of the first 200 points (200 ns) is subtracted from the whole signal (\ref {fig:b-baseline}); then waveforms are then normalised to their maximum in order to have their amplitude between 0 and 1 (\ref {fig:c-normalised}); after that, they are aligned in time with the 50\% of the maximum as reference point to be aligned (\ref {fig:d-aligned}) and then trimmed in a 200 ns window around the center of the waveform, i.e. the alignement point \ref {fig:e-trimmed}. Finally the time derivative is computed in order to get the current waveforms exhibit in \ref {fig:f-current} where the two usual patterns of current in \ac {MSE} and \ac {SSE} are evident}{figure.caption.28}{}}
