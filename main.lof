\contentsline {figure}{\numberline {3.1}{\ignorespaces Windowed energy spectrum before (gray) and after (blue) the A/E cut. 90\% of the \ac {SSE} survives while almost all the \ac {MSE} are cut away.}}{29}{figure.caption.35}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Example of the energy spectrum recorded in the calibration from \textit {p03/r000}. The energy region of the cut is highlighted.}}{31}{figure.caption.36}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Illustration of the workflow of the data processing for two types of waveforms from the dataset: the red one is a typical \ac {MSE} waveform with a non-trivial structure while the blue one is a ordinary \ac {SSE} waveform. A detailed description of the process is given in the text.}}{33}{figure.caption.38}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Events selection for \ac {SSE} and \ac {MSE}. A detailed description of the procedure is given in the text.}}{34}{figure.caption.39}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Schematic representation of the VAE architecture. The encoder network maps the input waveform to a latent space characterized by a mean and variance, from which a latent vector is sampled. The decoder reconstructs the waveform from this latent representation. The loss function combines reconstruction loss and KL divergence, weighted by the hyperparameter.}}{37}{figure.caption.42}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Visualisation of the reconstruction ability of the \ac {VAE} in the validation set across different epochs. $\beta $ = 1, N$_{\sigma }$ = 3, N$_{\text {epochs}}$ = 100}}{38}{figure.caption.43}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Visualisation of the epoch evolution of the losses: total loss (left), reconstruction loss (center) and KL loss (right). $\beta $ = 1, N$_{\sigma }$ = 3, N$_{\text {epochs}}$ = 100}}{38}{figure.caption.44}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Reconstruction in the test set: \ac {SSE}-like waveform on the left and \ac {MSE}-like waveform on the right. $\beta $ = 1, N$_{\sigma }$ = 3, N$_{\text {epochs}}$ = 100}}{38}{figure.caption.45}%
