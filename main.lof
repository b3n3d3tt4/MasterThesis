\contentsline {figure}{\numberline {1.1}{\ignorespaces Energy spectra of solar neutrino fluxes of different reaction processes. Figure taken from \blx@tocontentsinit {0}\cite {SunNuFluxes}.}}{2}{figure.caption.7}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Feynman diagrams of neutrino-deuteron scatterings. On the left, the \ac {CC} interaction mediated by a $W^+$ boson; on the right, the \ac {NC} interaction mediated by the $Z^0$ boson. The subscript $\ell $ denotes a generic lepton flavour ($\ell = e, \mu , \tau $).}}{3}{figure.caption.12}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Representation of the two possible mass hierarchies: normal hierarchy on the left and inverted hierarchy on the right. The Figure specifies that $\Delta m^2_{21}$ is obtained via solar neutrinos measurements while $\Delta m^2_{32}$ is given by atmospheric neutrinos experiments. Different colours refer to different neutrino flavours: red for the electron flavour, blue for the muon one and green for the tau, respectively. Figure taken from \blx@tocontentsinit {0}\cite {fermilab-mass-ordering}.}}{8}{figure.caption.13}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Feynman diagrams of the two possible mass couplings. On the left the Dirac coupling, associated with $m_D$. On the right the Majorana coupling, associated with $M$.}}{9}{figure.caption.14}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Feynman diagram of $2\nu \beta \beta $. The process proceeds via the exchange of two virtual $W^-$ bosons, resulting in the simultaneous emission of two electrons and two electron antineutrinos.}}{10}{figure.caption.15}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Mass parabola for $A=76$ isobars. A detailed description is given in the text. Custom plot with data taken from \blx@tocontentsinit {0}\cite {AME2020-masses} and \blx@tocontentsinit {0}\cite {Ge76-Qvalue}.}}{11}{figure.caption.16}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Feynman diagram for neutrinoless double $\beta $-decay. The Majorana coupling of the neutrino with its own antineutrino (see Figure \ref {fig:feynman-massCouplings}) is shown.}}{11}{figure.caption.17}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Schematic representation of the energy distribution for the products in $2\nu \beta \beta $ and $0\nu \beta \beta $ decay modes. The $0\nu \beta \beta $ decay produces a mono-energetic peak at the $Q$-value, while the $2\nu \beta \beta $ decay results in a continuous spectrum.}}{12}{figure.caption.18}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces On the left, the whole experimental setup for the LEGEND-200 phase: the picture shows the \ac {hpge} detectors (1), the \ac {lar} instrumentation (2), the \ac {lar} cryostat (3) and the water tank provided with the Cherenkov detectors (4). On the right, a close-up of the \ac {lar} instrumentation where the detector strings are visible. Rendering by P. Krause, taken from \blx@tocontentsinit {0}\cite {LEGEND:setup}.}}{16}{figure.caption.19}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Drawing of the different Germanium detectors employed in LEGEND. From the left to the right: PPC, BEGe, Coax and IC detectors respectively. Rendering by D. Hervas.}}{17}{figure.caption.20}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Energy levels and band gaps. From the left: insulators, semiconductors and conductors. Original drawing.}}{19}{figure.caption.22}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Drawing of the different Germanium detectors employed in LEGEND with the \textit {p+} terminal highlighted in blue. From the left to the right: PPC, BEGe, Coax and IC detectors respectively. Rendering scripts are by D. Hervas.}}{21}{figure.caption.23}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Geometry of the detector V08682A. Own elaboration based on LEGEND detector specifications using Julia-based SolidStateDetectors software \blx@tocontentsinit {0}\cite {SSD-jl}.}}{21}{figure.caption.24}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Weighting potential (left) and weighting field (right) in the V08682A IC detector. Own elaboration based on LEGEND Metadata.}}{22}{figure.caption.28}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Example of a raw waveform from the DAQ. The windowing region is highlighted.}}{24}{figure.caption.31}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Decay chain of the ${}^{228}$Th source. Custom plot with data taken from \blx@tocontentsinit {0}\cite {Th228chain}.}}{26}{figure.caption.33}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Example of the energy spectrum recorded in a calibration run. Peaks listed in Tab \ref {tab:emission-peaks} are highlighted. Data for this example plot are from run \textit {r000} of period \textit {p03}.}}{26}{figure.caption.33}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Different outcomes after a gamma interaction in the detector volume, delimited in black. A detailed description of the phenomena illustrated is given in the text.}}{26}{figure.caption.34}%
